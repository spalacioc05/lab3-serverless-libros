              "raw": "{\n  \"titulo\": \"El principito (ilustrado)\",\n  \"autor\": \"Antoine de Saint-Exupéry\",\n  \"genero\": \"Fábula\",\n  \"paginas\": 120,\n  \"disponible\": false\n}"
            },
            "url": "http://localhost:3000/libros/{{libroId}}"
          },
          "response": []
