            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"paginas\": -5\n}"
            },
            "url": "http://localhost:3000/libros"
          },
          "response": []
        },
        {
          "name": "Obtener libro - id inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/libros/00000000-0000-0000-0000-000000000000"
          },
          "response": []
        }
      ]
    }
  ]
}
